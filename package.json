{
	"name": "mini-diary",
	"productName": "Mini Diary",
	"version": "4.0.0",
	"description": "Simple and secure journal app",
	"type": "module",
	"main": "./out/main/main.js",
	"author": {
		"name": "Samuel Meuli",
		"email": "me@samuelmeuli.com",
		"url": "https://samuelmeuli.com"
	},
	"repository": "github:samuelmeuli/mini-diary",
	"homepage": "https://minidiary.app",
	"license": "MIT",
	"private": true,
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"start": "electron-vite dev",
		"build": "electron-vite build",
		"dist": "electron-vite build && electron-builder --mac --arm64",
		"website:start": "yarn website:build:css && tsc --project ./website --watch & serve ./website --listen 3000",
		"website:build": "yarn website:build:css && tsc --project ./website",
		"website:build:css": "cp ./node_modules/minireset.css/minireset.min.css ./website/styles/",
		"test": "yarn test:unit && yarn test:types",
		"test:unit": "vitest run",
		"test:types": "tsc --build && tsc --project ./website --noEmit",
		"lint:css": "stylelint --ignore-path ./.gitignore --max-warnings 0 \"**/*.{css,sass,scss}\"",
		"lint:css:fix": "yarn lint:css --fix",
		"lint:ts": "eslint --max-warnings 0 .",
		"lint:ts:fix": "yarn lint:ts --fix",
		"format": "prettier --ignore-path ./.gitignore --list-different \"**/*.{css,html,js,json,jsx,less,md,scss,ts,tsx,vue,yaml,yml}\"",
		"format:fix": "prettier --ignore-path ./.gitignore --write \"**/*.{css,html,js,json,jsx,less,md,scss,ts,tsx,vue,yaml,yml}\""
	},
	"devDependencies": {
		"@daypicker/react": "^10.0.2",
		"@eslint-react/eslint-plugin": "^5.28.8",
		"@eslint/js": "^10.0.1",
		"@lexical/headless": "^0.52.0",
		"@lexical/list": "^0.52.0",
		"@lexical/markdown": "^0.52.0",
		"@lexical/plain-text": "^0.52.0",
		"@lexical/react": "^0.52.0",
		"@lexical/rich-text": "^0.52.0",
		"@lexical/utils": "^0.52.0",
		"@reduxjs/toolkit": "^2.13.0",
		"@types/lodash.debounce": "^4.0.9",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/redux-logger": "^3.0.13",
		"@types/semver": "^7.8.0",
		"@vitejs/plugin-react": "^6.1.2",
		"electron": "^45.0.0",
		"electron-builder": "^26.18.0",
		"electron-context-menu": "^5.1.0",
		"electron-debug": "^5.0.0",
		"electron-log": "^5.4.4",
		"electron-vite": "^6.0.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"feather-icons": "^4.29.2",
		"globals": "^17.13.0",
		"lexical": "^0.52.0",
		"lodash.debounce": "^4.0.8",
		"marked": "^18.1.1",
		"minireset.css": "^0.0.7",
		"minisearch": "^7.2.0",
		"mockdate": "^3.0.5",
		"moment": "^2.31.0",
		"moment-timezone": "^0.6.5",
		"prettier": "^3.9.10",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-redux": "^9.3.0",
		"redux-logger": "^3.0.6",
		"remark": "^15.0.1",
		"sass": "^1.106.1",
		"semver": "^7.8.5",
		"serve": "^14.2.6",
		"strip-markdown": "^6.0.0",
		"stylelint": "^17.16.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vite-plugin-svgr": "^5.2.0",
		"vitest": "^5.0.5",
		"word-count": "^0.3.1"
	},
	"prettier": {
		"printWidth": 100,
		"useTabs": true,
		"trailingComma": "all",
		"arrowParens": "avoid"
	},
	"build": {
		"appId": "com.samuelmeuli.minidiary",
		"files": [
			"out/**/*"
		],
		"publish": null,
		"mac": {
			"target": [
				"dmg",
				"zip"
			],
			"category": "public.app-category.lifestyle",
			"identity": "-",
			"darkModeSupport": true,
			"electronLanguages": [
				"de",
				"de_AT",
				"de_CH",
				"de_DE",
				"el",
				"en",
				"en_AU",
				"en_CA",
				"en_GB",
				"en_NZ",
				"en_US",
				"en_ZA",
				"es",
				"es_419",
				"fr",
				"fr_CA",
				"fr_CH",
				"fr_FR",
				"is",
				"it",
				"it_CH",
				"it_IT",
				"nb",
				"no",
				"pt",
				"pt_BR",
				"pt_PT",
				"tr",
				"uk",
				"zh",
				"zh_CN",
				"zh_TW"
			],
			"entitlements": "./build/entitlements.mac.plist",
			"entitlementsInherit": "./build/entitlements.mac.plist",
			"hardenedRuntime": true
		},
		"linux": {
			"category": "Utility"
		},
		"dmg": {
			"icon": false
		}
	}
}
